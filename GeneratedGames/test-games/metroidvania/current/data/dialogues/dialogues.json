    {
      "id": "dlg_npc_001_greet",
      "lines": [
        {
          "text": "Welcome, traveler.",
          "portrait": "merchant"
        },
        {
          "text": "Looking to trade scrap for supplies?",
          "choices": [
            {
              "text": "Show me your wares.",
              "end": true,
              "action": "open_shop"
            },
            {
              "text": "Maybe later.",
              "nextDialogueId": "dlg_npc_001_later"
            }
          ]
        }
      ]
    },
    {
      "id": "dlg_npc_001_later",
      "lines": [
        {
          "text": "Safe travels.",
          "portrait": "merchant"
        }
      ]
    },
    {
      "id": "dlg_npc_002_lore",
      "lines": [
        {
          "text": "These halls remember Stormglass Reliquary - Side-view Test.",
          "portrait": "lore"
        },
        {
          "text": "What would you like to know?",
          "choices": [
            {
              "text": "Tell me about the conflict.",
              "nextDialogueId": "dlg_npc_002_conflict"
            },
            {
              "text": "Any advice?",
              "nextDialogueId": "dlg_npc_002_advice"
            },
            {
              "text": "Farewell.",
              "end": true
            }
          ]
        }
      ]
    },
    {
      "id": "dlg_npc_002_conflict",
      "lines": [
        {
          "text": "Restore the weather seals before the reliquary is swallowed by the permanent storm",
          "portrait": "lore"
        },
        {
          "text": "Tread carefully.",
          "portrait": "lore"
        }
      ]
    },
    {
      "id": "dlg_npc_002_advice",
      "lines": [
        {
          "text": "Upgrade your abilities before facing the final boss.",
          "portrait": "lore"
        }
      ]
    },
    {
      "id": "dlg_npc_003_neutral",
      "lines": [
        {
          "text": "Stay safe out there.",
          "portrait": "neutral"
        },
        {
          "text": "Need directions?",
          "choices": [
            {
              "text": "Where is the boss?",
              "nextDialogueId": "dlg_npc_003_boss_hint"
            },
            {
              "text": "Thanks.",
              "end": true
            }
          ]
        }
      ]
    },
    {
