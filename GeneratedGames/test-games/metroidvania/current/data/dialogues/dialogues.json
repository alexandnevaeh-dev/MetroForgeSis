      "id": "quest_000_offer",
      "lines": [
        {
          "speaker": "Quest Giver",
          "text": "I need help with \"Awakening\".",
          "portrait": "quest_giver"
        },
        {
          "text": "Complete objective 1 in Stormglass Reliquary - Side-view Test."
        },
        {
          "text": "Will you take this on?",
          "choices": [
            {
              "text": "Yes, I will help.",
              "end": true,
              "action": "accept_quest"
            },
            {
              "text": "Not right now.",
              "nextDialogueId": "quest_000_decline"
            }
          ]
        }
      ]
    },
    {
      "id": "quest_000_decline",
      "lines": [
        {
          "text": "Come back when you are ready.",
          "portrait": "quest_giver"
        }
      ]
    },
    {
      "id": "quest_000_active",
      "lines": [
        {
          "text": "Any progress on \"Awakening\" yet?",
          "portrait": "quest_giver"
        }
      ]
    },
    {
      "id": "quest_000_complete",
      "lines": [
        {
          "text": "Thank you for finishing \"Awakening\".",
          "portrait": "quest_giver"
        }
      ]
