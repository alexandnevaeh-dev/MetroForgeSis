; Engine configuration file.
; MetroForge AI — Top-Down Action Adventure Runtime Template v0.1.0

config_version=5

[application]

config/name="MetroForge Template"
config/description="Reusable top-down action-adventure runtime template"
run/main_scene="res://scenes/boot/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/core/GameManager.gd"
EventBus="*res://scripts/core/EventBus.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
ProgressionManager="*res://scripts/core/ProgressionManager.gd"
SettingsManager="*res://scripts/core/SettingsManager.gd"
QuestManager="*res://scripts/core/QuestManager.gd"
MapManager="*res://scripts/core/MapManager.gd"
InventoryManager="*res://scripts/core/InventoryManager.gd"
DialogueManager="*res://scripts/core/DialogueManager.gd"
ShopManager="*res://scripts/core/ShopManager.gd"
VFXManager="*res://scripts/core/VFXManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

