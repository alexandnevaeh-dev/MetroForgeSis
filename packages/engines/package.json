{
  "name": "@metroforge/engines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./live-edit-session": {
      "types": "./dist/live-edit-session.d.ts",
      "import": "./dist/live-edit-session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@metroforge/godot": "workspace:*",
    "@metroforge/procedural": "workspace:*",
    "@metroforge/schemas": "workspace:*",
    "@metroforge/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
