# MetroForge AI Configuration
# Copy to .env and fill in optional provider keys

# Application
METROFORGE_APP_NAME=MetroForge AI
METROFORGE_DATA_DIR=
METROFORGE_GENERATED_GAMES_DIR=GeneratedGames
METROFORGE_LOG_LEVEL=info

# Generation defaults
METROFORGE_DEFAULT_MODE=LOCAL_ONLY
METROFORGE_DEFAULT_PROFILE=TINY_TEST

# Godot
GODOT_EXECUTABLE=
GODOT_VERSION=4

# Model Scout
METROFORGE_SCOUT_INTERVAL_HOURS=24
METROFORGE_MODELS_DIR=models

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=

# Optional free hosted providers (leave empty to disable)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# NVIDIA NIM / API Catalog (free developer tier — see docs before relying on it for
# production load, it is not a production SLA). Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# Hosted Visual GenAI invoke base (image generation — not OpenAI /images/generations)
NVIDIA_IMAGE_API_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# hosted (default) | nim (global — prefer NVIDIA_NIM_BASE_URL for edit-only NIM)
NVIDIA_DEPLOYMENT=hosted
# OpenAI-compatible NIM root. Accepts https://host or https://host/v1 (normalized once).
# Example: https://gpu-host.example.com/v1
NVIDIA_NIM_BASE_URL=
# Optional NIM-specific auth (falls back to NVIDIA_API_KEY when unset)
NVIDIA_NIM_API_KEY=
# Preferred NIM edit model id when NVIDIA_NIM_BASE_URL is set
NVIDIA_IMAGE_EDIT_MODEL=qwen/qwen-image-edit-2511
# External NIM weight cache (never inside the git repo)
NVIDIA_NIM_CACHE_DIR=

# ComfyUI (optional local image)
COMFYUI_BASE_URL=http://localhost:8188

# AUTOMATIC1111 / SD webui (optional local image — enable --api, do not assume it is running)
AUTOMATIC1111_BASE_URL=

# Diffusers Python worker (optional local SDXL + Stable Audio)
# Optional. Leave unset to use python3 on macOS/Linux and python on Windows.
# DIFFUSERS_PYTHON=/absolute/path/to/python
DIFFUSERS_MODEL_ID=stabilityai/sdxl-turbo
STABLE_AUDIO_MODEL_ID=stabilityai/stable-audio-open-1.0

# Optional image/cloud fallbacks (leave empty — never silently spend money)
HF_TOKEN=
HF_IMAGE_MODEL=
STABILITY_API_KEY=
DEEPAI_API_KEY=
REPLICATE_API_TOKEN=

# RunPod remote GPU execution backend (optional — leave empty to disable)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_ENDPOINT_URL=
RUNPOD_WORKER_IMAGE=
RUNPOD_GPU_PROFILE=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_MODEL_PROFILE=
RUNPOD_DEPLOYMENT_MODE=

# Generic custom remote MetroForge worker (optional — leave empty to disable)
METROFORGE_REMOTE_WORKER_URL=
METROFORGE_REMOTE_WORKER_TOKEN=

# Hugging Face ZeroGPU Space (free development GPU — optional, leave empty to disable)
# HF_TOKEN above is reused here for authenticated ZeroGPU quota.
HF_SPACE_ID=
HF_SPACE_API_NAME=

# Lightning AI free-credit GPU Studio remote worker (optional — leave empty to disable)
LIGHTNING_API_KEY=
LIGHTNING_STUDIO_URL=
LIGHTNING_GPU_TYPE=

# Kaggle development/benchmarking profile (manual export/import — optional)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_NOTEBOOK_SLUG=

# Colab experimental/manual profile (interactive-only, no persistent worker — optional)
COLAB_NOTEBOOK_URL=

# Security - never commit real keys
# Keys are read from environment only, never bundled in frontend
