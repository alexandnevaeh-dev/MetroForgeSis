{
  "name": "metroforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Metroidvania game generation platform",
  "type": "module",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --dir packages apps tests",
    "test:integration": "vitest run --dir packages apps tests --testNamePattern integration",
    "test:watch": "vitest",
    "doctor": "pnpm --filter @metroforge/cli build && node apps/cli/dist/index.js doctor",
    "validate": "pnpm typecheck && pnpm test && pnpm build",
    "smoke:generate": "pnpm build && node scripts/smoke-generate.mjs",
    "smoke:godot": "pnpm build && node scripts/smoke-godot.mjs",
    "providers:image:doctor": "pnpm build:cli && node apps/cli/dist/index.js providers:image:doctor",
    "providers:nvidia:image:probe": "pnpm build:cli && node apps/cli/dist/index.js providers:nvidia:image:probe",
    "providers:nvidia:image:edit:probe": "pnpm build:cli && node apps/cli/dist/index.js providers:nvidia:image:edit:probe",
    "providers:nvidia:doctor": "pnpm build:cli && node apps/cli/dist/index.js providers:nvidia:doctor",
    "providers:hardware:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:hardware:doctor",
    "providers:diffusers:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:diffusers:doctor",
    "providers:reference:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:reference:doctor",
    "providers:runpod:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:runpod:doctor",
    "providers:remote:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:remote:doctor",
    "providers:huggingface:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:huggingface:doctor",
    "providers:lightning:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:lightning:doctor",
    "providers:kaggle:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:kaggle:doctor",
    "providers:colab:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:colab:doctor",
    "providers:free:route": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:free:route",
    "providers:reference:probe:free": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:reference:probe:free",
    "providers:huggingface:reference:probe": "node scripts/cli-build.mjs && node apps/cli/dist/index.js providers:huggingface:reference:probe",
    "remote:worker:build": "node scripts/cli-build.mjs && node apps/cli/dist/index.js remote:worker:build",
    "remote:worker:deploy": "node scripts/cli-build.mjs && node apps/cli/dist/index.js remote:worker:deploy",
    "remote:model:install": "node scripts/cli-build.mjs && node apps/cli/dist/index.js remote:model:install",
    "remote:model:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js remote:model:doctor",
    "reference:setup:plan": "node scripts/cli-build.mjs && node apps/cli/dist/index.js reference:setup:plan",
    "models:install-reference": "node scripts/cli-build.mjs && node apps/cli/dist/index.js models:install-reference",
    "models:doctor": "node scripts/cli-build.mjs && node apps/cli/dist/index.js models:doctor",
    "benchmark:reference-providers": "node scripts/cli-build.mjs && node apps/cli/dist/index.js benchmark:reference-providers",
    "production:player": "node scripts/cli-build.mjs && node apps/cli/dist/index.js production:player",
    "validate:godot": "pnpm smoke:godot",
    "desktop:build": "pnpm --filter @metroforge/desktop build",
    "build:cli": "pnpm --filter @metroforge/cli build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "metroforge": "node apps/cli/dist/index.js",
    "dev:desktop": "pnpm --filter @metroforge/desktop dev",
    "dev:cli": "pnpm --filter @metroforge/cli dev",
    "capture:ui": "node scripts/capture-ui-screenshots.mjs",
    "capture:ui-contact": "node scripts/build-contact-sheet.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "15.15.0",
    "playwright": "1.49.1",
    "prettier": "^3.4.2",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
